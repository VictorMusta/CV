---
import { Font } from 'astro:assets';
import '../styles/global.css';

type Mode = 'hub' | 'jeu' | 'dev' | 'sites' | 'cv';

interface Props {
  titre: string;
  description: string;
  mode: Mode;
  /** Variables CSS des polices utilisées par la page (déclarées dans astro.config.mjs). */
  polices: string[];
  /** Polices critiques, préchargées : le titre et le texte courant. */
  precharger?: string[];
  image?: string;
  indexer?: boolean;
  jsonld?: Record<string, unknown>;
}

const { titre, description, mode, polices, precharger = [], image = '/og/accueil.png', indexer = true, jsonld } = Astro.props;

// La signature (Fraunces) figure sur toutes les pages.
const toutes = [...new Set(['--font-fraunces', ...polices])];
const canonique = new URL(Astro.url.pathname, Astro.site);
const imageAbsolue = new URL(image, Astro.site);
const couleurTheme: Record<Mode, string> = { hub: '#0E0C0A', jeu: '#0D1120', dev: '#F4F1EA', sites: '#F7F0E4', cv: '#FFFFFF' };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexer && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={couleurTheme[mode]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/pdf" title="CV (PDF)" href="/pdf/Victor_Grabowski_CV_Dev.pdf" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {toutes.map((v) => <Font cssVariable={v} preload={precharger.includes(v)} />)}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body data-mode={mode}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
