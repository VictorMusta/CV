---
/*
 * LE FEU DE CAMP, en pixel art, calculé au build.
 *
 * Clin d'œil à la fin de Platformer2D (un chevalier qui se repose près d'un feu,
 * « Please rest now… ») et aux havres des jeux qui ont inspiré le site. Trois images
 * de flamme alternent par une animation CSS en paliers ; la base (bûches, pierres)
 * ne bouge pas. Aucune image à charger : tout tient dans le HTML.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 192, class: className } = Astro.props;

const PX = { r: '#C8391F', o: '#EE7A1E', y: '#F7C548', w: '#FFF3C9', b: '#6B3F22', l: '#A0663A', k: '#3E2615', s: '#4E4A45', g: '#7C766E' };
type Cell = [number, number, keyof typeof PX];

// Générateur déterministe : la même graine donne toujours la même flamme.
function mulberry(a: number) {
  return () => {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function flamme(graine: number): Cell[] {
  const r = mulberry(graine * 977 + 13);
  const cases = new Map<string, Cell>();
  const poser = (x: number, y: number, c: keyof typeof PX) => cases.set(`${x},${y}`, [x, y, c]);
  const base = 18, sommet = 3;
  for (let y = sommet; y <= base; y++) {
    const t = (base - y) / (base - sommet);
    const demi = 6.4 * Math.pow(1 - t, 0.72) * Math.min(1, 0.5 + t * 2.2);
    const cx = 12 + Math.sin(t * 4.4 + graine * 2.1) * 1.4 * t;
    for (let x = 0; x < 24; x++) {
      const d = Math.abs(x + 0.5 - cx) / Math.max(0.35, demi + (r() - 0.5) * 0.9);
      if (d > 1) continue;
      poser(x, y, d < 0.34 && t < 0.52 ? 'w' : d < 0.62 && t < 0.8 ? 'y' : d < 0.86 ? 'o' : 'r');
    }
  }
  poser(8 + Math.floor(r() * 2), 2 + Math.floor(r() * 3), 'o');
  poser(15 + Math.floor(r() * 2), 1 + Math.floor(r() * 3), 'y');
  return [...cases.values()];
}

function socle(): Cell[] {
  const cases: Cell[] = [];
  const buche = (x0: number, y0: number, x1: number, y1: number) => {
    const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0));
    for (let i = 0; i <= n; i++) {
      const x = Math.round(x0 + ((x1 - x0) * i) / n), y = Math.round(y0 + ((y1 - y0) * i) / n);
      cases.push([x, y, 'l'], [x, y + 1, 'b'], [x, y + 2, 'k']);
    }
  };
  buche(3, 19, 20, 16);
  buche(4, 16, 21, 19);
  for (const [x, y] of [[3, 19], [4, 16], [20, 16], [21, 19]]) cases.push([x, y, 'y'], [x, y + 1, 'l']);
  const pierres: Cell[] = [[1, 21, 'g'], [2, 21, 's'], [2, 20, 'g'], [5, 22, 's'], [6, 22, 'g'], [9, 22, 's'], [10, 22, 'g'], [13, 22, 'g'], [14, 22, 's'], [17, 22, 'g'], [18, 22, 's'], [21, 20, 'g'], [21, 21, 's'], [22, 21, 'g']];
  return cases.concat(pierres);
}

const images = [1, 2, 3].map(flamme);
const fixe = socle();
---
<svg class:list={['feu', className]} width={size} height={size} viewBox="0 0 24 24" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {images.map((cases, i) => (
    <g class={`image image-${i}`}>
      {cases.map(([x, y, c]) => <rect x={x} y={y} width="1" height="1" fill={PX[c]} />)}
    </g>
  ))}
  {fixe.map(([x, y, c]) => <rect x={x} y={y} width="1" height="1" fill={PX[c]} />)}
</svg>

<style>
  .image { animation: flamme 0.6s steps(1, end) infinite; }
  .image-1 { animation-delay: -0.2s; }
  .image-2 { animation-delay: -0.4s; }

  @keyframes flamme {
    0% { opacity: 1; }
    33.3% { opacity: 0; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .image { animation: none; }
    .image-1, .image-2 { opacity: 0; }
  }
</style>
