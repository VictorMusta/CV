---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Campfire from '../components/Campfire.astro';
import Icon from '../components/Icon.astro';

/* Les trois chemins : chaque carte porte le thème de sa destination (data-mode). */
const chemins = [
  { mode: 'jeu', href: '/jeu', icone: 'gamepad', titre: 'Game Design', texte: 'Game jams, prototypes et mods.', preuveIcone: 'medal', preuve: '2 jams, 2 prix du meilleur gameplay' },
  { mode: 'dev', href: '/dev', icone: 'code', titre: 'Développement web', texte: 'Fullstack TypeScript & .NET.', preuveIcone: 'shield', preuve: 'En poste chez Betclic, anti-fraude' },
  { mode: 'sites', href: '/sites', icone: 'browser', titre: 'Création de sites', texte: 'Vitrines, boutiques en ligne, abonnements.', preuveIcone: 'check', preuve: 'Coquelicots · Turf-Horses' },
] as const;

const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Victor Grabowski',
  jobTitle: 'Développeur fullstack TypeScript et .NET · game design',
  email: 'mailto:victorgrabowski33@gmail.com',
  url: 'https://lootopia.site/',
  sameAs: ['https://github.com/VictorMusta', 'https://www.linkedin.com/in/vgrabowski/'],
  address: { '@type': 'PostalAddress', addressLocality: 'Bordeaux', addressCountry: 'FR' },
  worksFor: { '@type': 'Organization', name: 'Betclic Everest Group' },
};
---
<Base
  titre="Victor Grabowski — Game design, développement web, création de sites"
  description="Victor Grabowski, à Bordeaux : game design (deux prix du meilleur gameplay en game jam), développement fullstack TypeScript et .NET, création de sites pour les commerces et indépendants."
  mode="hub"
  polices={['--font-mono', '--font-cinzel', '--font-alegreya', '--font-grotesk', '--font-plex', '--font-figtree']}
  precharger={['--font-fraunces']}
  image="/og/accueil.png"
  jsonld={personne}
>
  <div class="scene">
    <div class="lueur" aria-hidden="true"></div>
    <header class="entete">
      <Wordmark />
      <nav class="raccourcis" aria-label="Raccourcis">
        <a href="/60-secondes"><Icon name="stopwatch" size={18} /><span>Le CV en 60 secondes</span></a>
        <a href="/pdf/Victor_Grabowski_CV_Dev.pdf" download><Icon name="typewriter" size={18} /><span>Sauvegarder le CV</span></a>
      </nav>
    </header>

    <main id="contenu" class="foyer">
      <p class="annonce"><span aria-hidden="true"></span>Feu de camp allumé<span aria-hidden="true"></span></p>
      <h1>Pour convaincre cinq amis d’essayer un jeu vidéo, j’ai fini par leur créer un site.</h1>
      <p class="suite">Ils s’en servent encore. Trois chemins partent de ce feu : prenez celui qui vous amène.</p>

      <div class="feu">
        <Campfire size={192} />
        <span class="braise" style="--x: -30px; --d: 0s"></span>
        <span class="braise" style="--x: 22px; --d: -0.5s"></span>
        <span class="braise" style="--x: -8px; --d: -1.1s"></span>
        <span class="braise" style="--x: 36px; --d: -1.6s"></span>
        <span class="braise" style="--x: -44px; --d: -2s"></span>
      </div>

      <svg class="sentiers" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M570 0 C 470 30, 260 50, 200 90" />
        <path d="M600 0 L 600 90" />
        <path d="M630 0 C 730 30, 940 50, 1000 90" />
      </svg>

      <ul class="chemins">
        {chemins.map((c) => (
          <li>
            <a class="chemin" href={c.href} data-mode={c.mode}>
              <span class="chemin__tete">
                <span class="chemin__icone"><Icon name={c.icone} size={24} /></span>
              </span>
              <span class="chemin__titre">{c.titre}</span>
              <span class="chemin__texte">{c.texte}</span>
              <span class="chemin__preuve"><Icon name={c.preuveIcone} size={16} />{c.preuve}</span>
              <span class="chemin__cta">Prendre ce chemin<Icon name="arrow" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="astuce">On peut changer de chemin à tout moment, en haut de chaque page.</p>
    </main>
  </div>
</Base>

<style>
  .scene {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    font-family: var(--font-mono);
  }
  .lueur {
    position: absolute;
    left: 50%;
    top: 130px;
    width: 720px;
    height: 720px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(240, 163, 58, 0.2) 0%, rgba(240, 163, 58, 0.07) 38%, rgba(240, 163, 58, 0) 68%);
    pointer-events: none;
  }

  .entete {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 16px clamp(16px, 4vw, 56px);
  }
  .raccourcis { display: flex; gap: 8px 28px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .raccourcis a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: none; }
  .raccourcis a:hover { color: var(--text); }
  .raccourcis :global(svg) { color: var(--flame); }

  .foyer {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(calc(100% - 2 * var(--gutter)), var(--container));
    margin-inline: auto;
    padding: 12px 0 32px;
    text-align: center;
  }
  .annonce {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--flame);
  }
  .annonce span { width: 72px; height: 1px; background: var(--flame); opacity: 0.5; }
  h1 {
    max-width: 1100px;
    margin-top: 20px;
    font-family: var(--font-fraunces);
    font-size: clamp(29px, 4.2vw, 48px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .suite {
    margin-top: 16px;
    font-family: var(--font-fraunces);
    font-style: italic;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--muted);
  }

  .feu { position: relative; margin-top: 16px; width: 192px; height: 192px; }
  .braise {
    position: absolute;
    left: calc(50% + var(--x));
    top: 36px;
    width: 4px;
    height: 4px;
    background: var(--flame);
    animation: monte 2.4s linear infinite;
    animation-delay: var(--d);
  }
  @keyframes monte {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: translateY(-130px); opacity: 0; }
  }

  .sentiers {
    width: 100%;
    height: 90px;
    fill: none;
    stroke: var(--flame);
    stroke-opacity: 0.4;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1 12;
  }
  .sentiers path { vector-effect: non-scaling-stroke; }

  .chemins {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    width: 100%;
    text-align: left;
  }
  .chemin {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 26px 26px 22px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background-color: var(--bg);
    background-image: var(--paper-grid, none);
    background-size: 24px 24px;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .chemin:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(240, 163, 58, 0.18); }
  .chemin__icone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .chemin__titre { margin-top: 4px; font-family: var(--font-display); font-size: 27px; line-height: 1.1; font-weight: 700; }
  .chemin__texte { font-family: var(--font-body); font-size: 16px; color: var(--muted); }
  .chemin__preuve {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--accent);
  }
  .chemin__cta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .astuce { margin-top: 28px; font-size: 12px; letter-spacing: 0.06em; color: var(--muted); }

  @media (max-width: 980px) {
    .sentiers { display: none; }
    .chemins { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 20px; max-width: 560px; }
    .chemin { padding: 18px 20px; }
    .chemin__titre { font-size: 22px; }
  }
  @media (max-width: 560px) {
    .annonce span { width: 36px; }
    .feu { width: 128px; height: 128px; }
    .feu :global(svg) { width: 128px; height: 128px; }
    .braise { top: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .braise { animation: none; opacity: 0.6; }
    .chemin { transition: none; }
    .chemin:hover { transform: none; }
  }
</style>
