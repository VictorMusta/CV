# Copier en .env (local) ou dans /opt/portfolio/.env (VPS). Ce fichier ne contient
# jamais de vraie valeur : le .env réel n'est ni commité ni synchronisé par le déploiement.

# Clé API Resend (https://resend.com). Sans elle, le formulaire de contact répond
# « indisponible » et propose l'e-mail direct ; en local, la demande est affichée
# dans la console au lieu d'être envoyée.
RESEND_API_KEY=

# Adresse qui reçoit les demandes du formulaire.
CONTACT_TO=

# Expéditeur des e-mails : doit appartenir à un domaine vérifié chez Resend.
CONTACT_FROM="Portfolio <contact@lootopia.site>"
